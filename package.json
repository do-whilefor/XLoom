{
  "name": "xloom",
  "version": "0.7.0",
  "description": "XLoom M6: evidence aggregation, verified attack paths and reproducible investigation reports",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "bin": {
    "xloom": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "config.example.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "0.34.41",
    "chalk": "5.6.2",
    "chrome-devtools-mcp": "1.8.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "get-east-asian-width": "1.6.0",
    "highlight.js": "10.7.3",
    "marked": "18.0.5",
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "ssh2": "1.17.0",
    "strip-ansi": "7.1.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.11",
    "@types/ssh2": "1.15.6",
    "typescript": "5.9.3"
  }
}
