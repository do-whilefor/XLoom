{
  "name": "xloom",
  "version": "0.7.0",
  "description": "XLoom M6: evidence aggregation, verified attack paths and reproducible investigation reports",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "bin": {
    "xloom": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "config.example.json",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit",
    "check:pi": "node scripts/check-pi-source.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/live-phase7.ts",
    "test:pty": "python3 scripts/pty-phase4.py",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test:live:phase1": "node --import tsx scripts/live-smoke.ts",
    "test:pty:phase1": "python3 scripts/pty-smoke.py",
    "test:live:phase2": "node --import tsx scripts/live-phase2.ts",
    "test:pty:phase2": "python3 scripts/pty-phase2.py",
    "test:live:phase3": "node --import tsx scripts/live-phase3.ts",
    "test:pty:phase3": "python3 scripts/pty-phase3.py",
    "test:live:phase4": "node --import tsx scripts/live-phase4.ts",
    "test:backends": "node --import tsx scripts/live-backends-phase5.ts",
    "test:chrome": "node --import tsx scripts/live-chrome.ts",
    "test:chrome:live": "node --import tsx scripts/live-chrome-model.ts",
    "test:live:phase5": "node --import tsx scripts/live-phase5.ts",
    "test:live:image": "node --import tsx scripts/live-phase6-image.ts",
    "test:live:cross": "node --import tsx scripts/live-phase6-cross.ts",
    "test:live:phase6": "node --import tsx scripts/live-phase6.ts",
    "test:kali": "node --import tsx scripts/live-kali.ts",
    "test:joint": "node --import tsx scripts/live-joint.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "0.34.41",
    "chalk": "5.6.2",
    "chrome-devtools-mcp": "1.8.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "get-east-asian-width": "1.6.0",
    "highlight.js": "10.7.3",
    "marked": "18.0.5",
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "ssh2": "1.17.0",
    "strip-ansi": "7.1.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.11",
    "@types/ssh2": "1.15.6",
    "@xterm/headless": "5.5.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
