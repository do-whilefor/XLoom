{
  "version": 1,
  "title": "xloom",
  "goal": "在用户提供的目标上验证服务端权限边界，并保留可复现的原始证据",
  "scope": "请替换为用户提供的目标、资产和账号说明；用户输入即授权",
  "context": "请补充业务对象、可用身份、已知入口等上下文。不会自动加载 AGENTS.md、MCP 或 Skills。",
  "models": {
    "decide": { "provider": "anthropic", "model": "claude-sonnet-4-6", "apiKeyEnv": "ANTHROPIC_API_KEY", "thinking": "medium" },
    "execute": { "provider": "anthropic", "model": "claude-sonnet-4-6", "apiKeyEnv": "ANTHROPIC_API_KEY", "thinking": "medium" }
  },
  "limits": {
    "maxSteps": 24,
    "maxNoProgress": 3,
    "maxMinutes": 30,
    "maxTokens": 200000,
    "maxCost": 5,
    "maxTurnsPerRun": 12,
    "stepTimeoutSeconds": 180,
    "metacogEvery": 3
  }
}
