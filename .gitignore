# Publish only files needed to build and use XLoom.
/*
!/.gitignore
!/LICENSE
!/README.md
!/config.example.json
!/package-lock.json
!/package.json
!/tsconfig.build.json
!/tsconfig.json
!/src/
!/scripts/
/scripts/*
!/scripts/copy-assets.mjs

# Keep documentation archives, tests, evaluations and runtime data local.
/docs/
/tests/
/evals/
node_modules/
dist/
coverage/
logs/
.xloom/
__pycache__/
*.py[cod]
.venv/
venv/
*.log
*.tap
*.tgz
*.tgz.sha256
.env
.env.*
auth.json
credentials.json
.DS_Store
*.swp
*.swo
*~
