# Publish only project source, build configuration and regression tests.
/*
!/.gitignore
!/LICENSE
!/README.md
!/config.example.json
!/package-lock.json
!/package.json
!/tsconfig.build.json
!/tsconfig.json
!/src/
!/tests/
!/scripts/
!/evals/

# Only build and test dependencies belong in scripts/.
